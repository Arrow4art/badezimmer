# Local demo password. Change before any real deployment.
ADMIN_PASSWORD=demo-badezimmer
ADMIN_SECRET=replace-with-a-long-random-string

# Public site URL used for Stripe return links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for checkout. Cash on delivery is not offered.
# Card data is collected by Stripe, never by this shop.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Upstash Redis for orders, stock, messages and newsletter on Vercel.
# The Vercel Upstash integration sets these. Without them the shop writes to data/.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional order and newsletter email via Resend.
RESEND_API_KEY=
ORDER_EMAIL_FROM=

# Set to true only after Impressum and policies are final.
ALLOW_INDEXING=false

# Google Ads tag. The account in the Ads URL uses this id.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18513827613
# Label of the Google Ads purchase conversion (send_to AW-…/<label>). Empty = the "Achat" action built into the code.
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
